<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>led-cube-studio</AssemblyName>
    <RootNamespace>LedCube.App</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>LED Cube Studio</Product>
    <Title>LED Cube Studio</Title>
    <Description>Cross-platform audio-reactive visualizer and controller for 8×8×8 RGB LED cubes</Description>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == 'win-x64'">../../assets/branding/generated/led-cube-studio.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LedCube.Core/LedCube.Core.csproj" />
    <ProjectReference Include="../LedCube.Hardware/LedCube.Hardware.csproj" />
    <ProjectReference Include="../LedCube.Audio/LedCube.Audio.csproj" />
    <PackageReference Include="Avalonia" Version="11.2.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.6" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../assets/branding/generated/led-cube-studio-256.png"
                      Link="Assets/led-cube-studio.png" />
  </ItemGroup>
</Project>
